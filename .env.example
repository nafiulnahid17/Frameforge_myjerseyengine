FRAMEFORGE_HOST=0.0.0.0
PORT=8000
FRAMEFORGE_ENGINE_TOKEN=replace-with-a-long-random-private-token
FRAMEFORGE_WORKSPACE=.runtime
FRAMEFORGE_MAX_UPLOAD_MIB=50
FRAMEFORGE_MAX_OUTPUT_MIB=600
FRAMEFORGE_MAX_WORKERS=4
FRAMEFORGE_REQUEST_TIMEOUT_SECONDS=600
FRAMEFORGE_VIDEO_POLL_SECONDS=5
FRAMEFORGE_RETENTION_HOURS=24
FRAMEFORGE_VIDEO_POSTPROCESS_REQUIRED=true
FRAMEFORGE_PUBLIC_BASE_URL=https://your-frame-forge-engine.example.com
FRAMEFORGE_ASSET_SIGNING_SECRET=replace-with-a-second-long-random-secret

OPENROUTER_API_KEY=replace-with-openrouter-private-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=https://your-private-my-jersey-app.example.com
OPENROUTER_APP_NAME=My Jersey Frame Forge AI

# Use values supported by the selected OpenRouter endpoints.
FRAMEFORGE_QUALITY_IMAGE_RESOLUTION=4K
FRAMEFORGE_COST_IMAGE_RESOLUTION=2K
FRAMEFORGE_QUALITY_VIDEO_RESOLUTION=1080p
FRAMEFORGE_COST_VIDEO_RESOLUTION=720p

# Comma-separated ordered fallback lists. These recommendations were checked
# against the OpenRouter model catalog on 2026-10-30. Re-check capabilities and
# pricing before production deployment because provider catalogs can change.
FRAMEFORGE_QUALITY_ANALYSIS_MODELS=openai/gpt-6.1-sol-pro,google/gemini-4-argon
FRAMEFORGE_QUALITY_IMAGE_MODELS=black-forest-labs/flux-3-image,google/gemini-3.1-flash-image
FRAMEFORGE_QUALITY_VIDEO_SHORT_MODELS=black-forest-labs/flux-3-video,alibaba/wan-3.0-prime
FRAMEFORGE_QUALITY_VIDEO_MEDIUM_MODELS=black-forest-labs/flux-3-video,alibaba/wan-3.0-prime
FRAMEFORGE_QUALITY_VIDEO_LONG_MODELS=alibaba/wan-3.0-prime,alibaba/wan-3.0

FRAMEFORGE_COST_ANALYSIS_MODELS=google/gemini-3.8-flash,openai/gpt-6-luna
FRAMEFORGE_COST_IMAGE_MODELS=bytedance-seed/seedream-5-0-flash,qwen/qwen-image-2.1-turbo
FRAMEFORGE_COST_VIDEO_SHORT_MODELS=x-ai/grok-imagine-video-1.5-lite,bytedance/seedance-2.5
FRAMEFORGE_COST_VIDEO_MEDIUM_MODELS=bytedance/seedance-2.5,alibaba/wan-3.0
FRAMEFORGE_COST_VIDEO_LONG_MODELS=bytedance/seedance-2.5,alibaba/wan-3.0

# Optional generic fallbacks used when duration-specific video pools are empty.
FRAMEFORGE_QUALITY_VIDEO_MODELS=
FRAMEFORGE_COST_VIDEO_MODELS=

# Exact HTTPS hostnames allowed for provider-returned media URLs. Data URLs do
# not need this. Add the actual OpenRouter/provider media hosts after verifying them.
FRAMEFORGE_OUTPUT_HOSTS=

